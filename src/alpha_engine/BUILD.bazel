load("@pip//:requirements.bzl", "requirement")
load("@rules_python//python:defs.bzl", "py_library", "py_test")

py_library(
    name = "base",
    srcs = ["strategies/base.py"],
    visibility = ["//visibility:public"],
)

py_library(
    name = "features",
    srcs = ["rl/features.py"],
    visibility = ["//visibility:public"],
    deps = [
        requirement("numpy"),
        requirement("polars"),
    ],
)

py_library(
    name = "env",
    srcs = ["rl/env.py"],
    visibility = ["//visibility:public"],
    deps = [
        ":base",
        requirement("gymnasium"),
        requirement("numpy"),
    ],
)

py_library(
    name = "strategies",
    srcs = [
        "strategies/__init__.py",
        "strategies/mean_reversion_strategy.py",
        "strategies/momentum_strategy.py",
        "strategies/rl_strategy.py",
        "strategies/stat_arb_strategy.py",
        "strategies/trend_strategy.py",
    ],
    visibility = ["//visibility:public"],
    deps = [
        ":base",
        ":features",
        requirement("numpy"),
        requirement("onnxruntime"),
    ],
)


py_library(
    name = "engine",
    srcs = ["engine.py"],
    visibility = ["//visibility:public"],
    deps = [
        ":base",
    ],
)

py_test(
    name = "alpha_engine_test",
    srcs = ["alpha_engine_test.py"],
    deps = [
        ":base",
        ":engine",
        ":env",
        ":features",
        ":strategies",
        requirement("numpy"),
        requirement("polars"),
        requirement("gymnasium"),
    ],
)

py_library(
    name = "data",
    srcs = [
        "data/__init__.py",
        "data/adjuster.py",
        "data/downloader.py",
        "data/schema.py",
        "data/storage.py",
        "data/validator.py",
    ],
    visibility = ["//visibility:public"],
    deps = [
        requirement("numpy"),
        requirement("polars"),
    ],
)

py_test(
    name = "data_pipeline_test",
    srcs = ["data/data_pipeline_test.py"],
    deps = [
        ":data",
        requirement("numpy"),
        requirement("polars"),
    ],
)

py_library(
    name = "analytics",
    srcs = ["analytics.py"],
    visibility = ["//visibility:public"],
    deps = [
        requirement("numpy"),
    ],
)

py_library(
    name = "backtest_driver",
    srcs = ["backtest_driver.py"],
    visibility = ["//visibility:public"],
    deps = [
        ":analytics",
        ":base",
        ":data",
        requirement("numpy"),
        requirement("polars"),
    ],
)

py_test(
    name = "backtest_test",
    srcs = ["backtest_test.py"],
    deps = [
        ":analytics",
        ":backtest_driver",
        ":base",
        ":data",
        requirement("numpy"),
        requirement("polars"),
    ],
)

py_test(
    name = "benchmark_validation_test",
    srcs = ["benchmark_validation_test.py"],
    deps = [
        ":analytics",
        ":backtest_driver",
        ":base",
        ":data",
        ":strategies",
        requirement("numpy"),
        requirement("polars"),
    ],
)

py_test(
    name = "strategy_metadata_test",
    srcs = ["strategy_metadata_test.py"],
    deps = [
        ":base",
        ":strategies",
    ],
)





